# =======================================================
# SUPABASE CONFIGURATION (Wajib untuk integrasi database)
# =======================================================
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
# URL Project Supabase Anda (contoh: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Anon / Public Key (Aman ditaruh di browser frontend, dilindungi oleh Row Level Security)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# PENTING: JANGAN PERNAH MENARUH service_role_key DI SINI ATAU DI FRONTEND!

# GEMINI_API_KEY: Optional if AI summarizer features are used
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
